{
  "name": "@mailbox/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/app/cli.ts --outfile dist/mailbox",
    "check-types": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test",
    "install:user": "bun run build && bun scripts/install.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "effect": "^3.22.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.32",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@davidvornholt/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "7.0.2"
  }
}
