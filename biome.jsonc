{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // Repo-owned wrapper. Extends the canonical strict base synced from
  // davidvornholt/standards. Add project-specific overrides here; never edit
  // biome.base.jsonc locally.
  "extends": ["./biome.base.jsonc"],
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // Terminal boundary: the hidden password prompt needs Node's raw-mode
      // APIs to disable echo, and TTY detection has no Bun equivalent. App code
      // otherwise must not import Node built-ins.
      "includes": ["apps/cli/src/shared/terminal.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      // CLI entrypoint: sets the exit code and writes stdout/stderr through
      // node:process. App code otherwise must not import Node built-ins.
      "includes": ["apps/cli/src/app/cli.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      // File paths: Bun has no API for the home or temporary directory or for
      // joining paths, so these files use node:os and node:path to work on
      // Windows as well as Linux and macOS. App code otherwise must not import
      // Node built-ins.
      "includes": [
        "apps/cli/scripts/install.ts",
        "apps/cli/src/app/attachment-file.ts",
        "apps/cli/src/app/attachment-file.test.ts",
        "apps/cli/src/app/cli.test.ts",
        "apps/cli/src/shared/accounts/config.ts",
        "apps/cli/src/shared/accounts/config.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    }
  ]
}
